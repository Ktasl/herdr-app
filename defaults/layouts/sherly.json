{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "background": "canvas",
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "top-bar",
      "type": "block",
      "size": {
        "px": 42
      },
      "window_drag": true,
      "content": {
        "mod": "sherly-bar"
      }
    },
    {
      "id": "work-body",
      "type": "row",
      "children": [
        {
          "id": "main",
          "type": "block",
          "content": {
            "tab": "active",
            "pane": {
              "background": "background",
              "lone": true,
              "focus": {
                "width": 1,
                "color": "accent"
              }
            }
          }
        },
        {
          "id": "panel",
          "type": "column",
          "hidden": true,
          "size": {
            "px": 280
          },
          "children": [
            {
              "id": "panel-body",
              "type": "stack",
              "active": "spaces",
              "children": [
                {
                  "id": "spaces",
                  "type": "block",
                  "content": {
                    "mod": "spaces"
                  }
                },
                {
                  "id": "agents",
                  "type": "block",
                  "content": {
                    "mod": "agents"
                  }
                },
                {
                  "id": "files",
                  "type": "block",
                  "content": {
                    "mod": "files"
                  }
                },
                {
                  "id": "changes",
                  "type": "block",
                  "content": {
                    "mod": "changes"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "right-toolbar",
          "type": "block",
          "size": {
            "px": 44
          },
          "content": {
            "mod": "sherly-sidebar"
          }
        }
      ]
    },
    {
      "id": "status",
      "type": "block",
      "size": {
        "px": 28
      },
      "content": {
        "mod": "sherly-status"
      }
    }
  ]
}

{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "background": "canvas",
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "top-bar",
      "type": "block",
      "size": {
        "px": 42
      },
      "window_drag": true,
      "content": {
        "mod": "sherly-bar"
      }
    },
    {
      "id": "work-body",
      "type": "row",
      "children": [
        {
          "id": "main",
          "type": "block",
          "content": {
            "tab": "active",
            "pane": {
              "lone": true,
              "focus": {
                "width": 1,
                "color": "accent"
              }
            }
          }
        },
        {
          "id": "panel",
          "type": "column",
          "hidden": false,
          "size": {
            "px": 280
          },
          "background": "chrome",
          "divider": {
            "width": 1,
            "color": "border"
          },
          "children": [
            {
              "id": "drawer-spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 80,
              "content": {
                "mod": "spaces"
              }
            },
            {
              "id": "drawer-agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 80,
              "hidden": true,
              "content": {
                "mod": "agents"
              }
            },
            {
              "id": "drawer-files",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 80,
              "hidden": true,
              "content": {
                "mod": "files"
              }
            },
            {
              "id": "drawer-changes",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 80,
              "hidden": true,
              "content": {
                "mod": "changes"
              }
            }
          ]
        },
        {
          "id": "right-toolbar",
          "type": "block",
          "size": {
            "px": 44
          },
          "background": "chrome",
          "content": {
            "mod": "sherly-sidebar"
          }
        }
      ]
    },
    {
      "id": "status",
      "type": "block",
      "size": {
        "px": 28
      },
      "content": {
        "mod": "sherly-status"
      }
    }
  ]
}
